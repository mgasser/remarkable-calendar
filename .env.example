# ---------------------------------------------------------------
# remarkable-calendar – Konfiguration (Kopie als .env ablegen)
# ---------------------------------------------------------------

# --- Allgemein -------------------------------------------------
TZ=Europe/Zurich
PLANNER_LANGUAGE=de            # de | en
PAGE_FORMAT=remarkable         # remarkable (rM1/rM2) | paperpro | move | a4 | a5 | letter
MONTHS_AHEAD=3                 # aktueller Monat + 2 weitere werden jede Nacht neu erzeugt
DAY_START_HOUR=6               # Zeitraster der Tages- und Wochenseiten
DAY_END_HOUR=22
NOTES_PAGES=10

# --- Composio (Google Tasks, optional Google Calendar) ---------
# API-Key: https://dashboard.composio.dev -> Settings -> API Keys
# User-ID: die User-ID, unter der Google Tasks verbunden ist (Dashboard -> Connected Accounts)
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
# Nur nötig, wenn mehrere Google-Konten unter derselben User-ID verbunden sind:
COMPOSIO_TASKS_ACCOUNT_ID=
COMPOSIO_CALENDAR_ACCOUNT_ID=
# Optional, z.B. 20251027_00; leer = Standardversion der API
COMPOSIO_TOOLKIT_VERSION=

# Google-Tasks-Listen (Name oder ID, kommagetrennt). Leer = alle Listen.
GOOGLE_TASKS_LISTS=

# Google-Kalender über Composio (Toolkit "googlecalendar" verbinden). Z.B. primary
GOOGLE_CALENDAR_IDS=
# Feiertage über Google, z.B. de.ch#holiday@group.v.calendar.google.com
HOLIDAY_CALENDAR_IDS=

# --- ICS-Feeds (alternativ oder zusätzlich) --------------------
# iCloud (öffentlicher Link), Outlook (ICS veröffentlichen), Google (geheime iCal-Adresse)
ICS_URLS=
HOLIDAY_ICS_URLS=

# --- Upload aufs Tablet ----------------------------------------
SYNC_MODE=cloud                # cloud | ssh | none
REMARKABLE_FOLDER=Kalender
# Einmalcode von https://my.remarkable.com/device/desktop/connect
# Wird beim Start nur verwendet, wenn noch kein Token gespeichert ist. Danach wieder leeren.
RMAPI_ONE_TIME_CODE=
# Nur für SYNC_MODE=ssh:
REMARKABLE_HOST=
REMARKABLE_PASSWORD=

# --- Zeitplan und Überwachung ----------------------------------
SYNC_TIMES=04:30               # mehrere: 04:30,12:30
RUN_ON_START=true
# Optional: z.B. https://hc-ping.com/<uuid> (Erfolg) bzw. .../fail (Fehler)
HEALTHCHECK_URL=
